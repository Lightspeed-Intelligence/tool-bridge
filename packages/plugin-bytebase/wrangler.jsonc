{
  // Bytebase MCP tool-provider plugin Worker。secrets:PLUGIN_TOKEN(注册后 wrangler secret put);
  // Bytebase 凭证(email/service_key)不在此配——存平台 SecretStore,经 X-TB-Upstream-Auth 每次传入。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tb-plugin-bytebase",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Lightspeed 账户(与 gateway/plugin-meego 同;wrangler OAuth 多账户须显式指定)。
  "account_id": "041d4868e5611b45f9959f4f58c1e4c7",
  "observability": {
    "enabled": true
  },
  "vars": {
    // Bytebase 实例 base URL(凭证 JSON 内 base_url 优先于此;二者皆缺则调用报 unavailable)。
    "BYTEBASE_BASE_URL": "https://bytebase.infra.fantacy.live",
    // 工具白名单(逗号分隔;留空 = 放行上游全部工具)。第一道闸是 SA 在 Bytebase 的 IAM 角色;
    // 想在 plugin 侧再收一道(如只留只读面)就填:"query_database,get_schema,search_api,get_skill"。
    "BYTEBASE_ALLOWED_TOOLS": ""
  }
}
