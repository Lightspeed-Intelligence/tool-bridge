{
  // tb-gateway Worker(Cloudflare 宿主适配器)。资源名从 TB_NAME_PREFIX(=tb)派生。
  //
  // **本文件不含任何账户特定值**:account_id / routes / TB_CANONICAL_ORIGIN /
  // TB_R2_S3_ENDPOINT 与 KV/D1 的 id 全部由 `pnpm provision` 从 .env
  // (CLOUDFLARE_ACCOUNT_ID / TB_DOMAIN / TB_BASE_URL / TB_NAME_PREFIX)幂等回填——
  // 回填结果是**你自己那份部署配置**,fork 后请勿把它推回公共仓库。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tb-gateway",
  // **不是 src/index.ts**:那个是**库入口**(npm 产物导出 createApp,不装配任何插件)。
  // 部署要的是 deployEntry.ts —— 它全量装配生成的内置插件目录。
  // 两个入口分开,免得 npm 消费者被迫吞下约 6 MB 插件代码。
  "main": "src/deployEntry.ts",
  // 与仓库锁定的 workerd/miniflare 支持上限一致；升级工具链时再同步推进。
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  // 生产只允许规范自定义域;关闭 workers.dev 与版本预览 URL,避免同一状态暴露多 origin。
  "workers_dev": false,
  "preview_urls": false,
  // Lightspeed 账户(.env CLOUDFLARE_ACCOUNT_ID);wrangler OAuth 下有多账户,须显式指定。
  "account_id": "041d4868e5611b45f9959f4f58c1e4c7",
  // 生产入口 = TB_BASE_URL(.env);zone fantacy.live 在同账户。
  "routes": [{ "pattern": "tool-bridge.fantacy.live", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  // 每个鉴权请求至少访问一次权威 D1 primary；Smart Placement 把 Worker 计算移近
  // 主要后端，避免一条请求内的多次 D1/上游往返都跨洲。注意 /ui 目前也先过 Worker，
  // 因此纯静态 Dashboard 的首字节可能不如 edge-first；核心 API 延迟优先。
  "placement": { "mode": "smart" },
  // Workers 无常驻进程：Store 的过期 session/share/call capability 与孤儿字节
  // 必须由 Cron Trigger 收敛，不能依赖请求顺带清理。
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    // 规范 origin(钉死 OAuth redirect_uri)。生产钉死 fantacy.live;provision 也会从 TB_BASE_URL 回填。
    "TB_CANONICAL_ORIGIN": "https://tool-bridge.fantacy.live",
    // r2 presign 的 bucket 名;S3 兼容端点由 CLOUDFLARE_ACCOUNT_ID 派生(缺省则大对象 $ref 走网关 /~ref 中转)。
    // presign 凭证本体走 SecretStore 'r2-presign' 或 wrangler secret,不入 vars。
    "TB_R2_BUCKET": "tb-r2",
    "TB_R2_S3_ENDPOINT": "https://041d4868e5611b45f9959f4f58c1e4c7.r2.cloudflarestorage.com",
    // 飞书登录:复用 feishu plugin 的 SecretStore 凭证(feishu-app),设置即启用 /login。
    "TB_FEISHU_LOGIN_SECRET_REF": "feishu-app",
    // meego 自动绑定(登录后 open_id → union_id → user_key 写入节点 userKeys)。
    // ⚠️ 必须留在此文件:wrangler deploy 的 vars 以本文件为准、不合并线上已有值——
    // 2026-08-08 的部署曾因此把这两项抹掉,导致此后登录全部静默跳过绑定。
    "TB_MEEGO_BIND_NODE": "plugins/meego",
    "TB_MEEGO_SECRET_REF": "meego-app",
    // 本实例在 X-TB-Via 链里的标识,用于联邦递归的环路检测(链中已含自己 → 判环拒绝)。
    // 显式配置它是 `search:federated` 能力的三个前提之一(另两个是 StateStore 原子 CAS
    // 与 SearchIndex.revision(),D1 已满足);缺省会从入站 host 派生,但派生值不稳定,
    // 联邦 cursor 与 revision 绑定都依赖它,故必须钉死。
    // 约束:全联邦网络内唯一、且**不含逗号**(Via 是逗号分隔链);一旦对外提供联邦
    // 就不应再改 —— 改了等于换了身份,在途的联邦分页会 fail closed。
    "TB_INSTANCE_ID": "tool-bridge.fantacy.live"
  },
  // D1:**一个库,两个 binding**(id 由 scripts/provision.mjs 幂等创建后回填;本地
  // wrangler dev / vitest-pool-workers 用 miniflare 本地实例,不校验 id)。
  // binding 表达用途、库表达存储位置——将来要拆库只动这里,不动代码:
  // - TB_STATE:权威 StateStore(表 tb_state_kv;ADR-001 从 KV 迁入——强一致读写、
  //   原子 putIfAbsent、撤销即时生效;树配置 / SK 哈希表 / 加密 secret / manifest 全在此)。
  // - TB_SEARCH:纯 LIKE 工具搜索索引(表 tb_search_*;可选,不配则无 search capability)。
  //
  // ⚠️ 本仓存量部署迁移提醒(ADR-001 对上游是 pre-launch 零迁移,对我们不是):
  // 生产权威数据原在 KV `TENANTS`(a1e48dcf2fe44872a828a992d6efd5e5)。切换到 D1 前
  // 必须先跑 scripts/migrate-kv-to-d1.mjs 把 KV 全量搬进 tb_state_kv,否则用户/凭证/
  // 节点全部读不到(数据仍在 KV,只是代码不再读它)。旧 tb-search 库(9244c856…)随之弃用
  // (纯索引可重建,无权威数据)。
  "d1_databases": [
    {
      "binding": "TB_STATE",
      "database_name": "tb-db",
      "database_id": "6e656585-1cee-431a-a8d7-db199c85bd9c"
    },
    {
      "binding": "TB_SEARCH",
      "database_name": "tb-db",
      "database_id": "6e656585-1cee-431a-a8d7-db199c85bd9c"
    }
  ],
  // R2:部署级 default Store、context r2 provider 与大对象 $ref。
  "r2_buckets": [
    { "binding": "TB_R2", "bucket_name": "tb-r2" }
  ],
  // Durable Objects:每设备一个 DeviceSession(WS hibernation)。
  "durable_objects": {
    "bindings": [{ "name": "TB_DEVICE", "class_name": "DeviceSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeviceSession"] }],
  // Dashboard 静态资源(Workers Static Assets,挂 /ui,与 gateway 一体部署)。
  // run_worker_first=true:一切请求先进 Worker,静态资源仅由 app.ts 的 /ui 路由经
  // ASSETS binding 显式转发——SPA 回退严格限定 /ui,不吞根 ~help/数据面/system/*
  // (路由次序要求)。directory 指向 dashboard 构建产物,
  // deploy 前须先 `pnpm --filter @tool-bridge/dashboard build`(deploy:all 已编排)。
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
